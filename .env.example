# Copy sang .env roi sua theo may cua ban:  cp .env.example .env

# --- Squash TM ---
SQUASH_VERSION=13.0.7.RELEASE
HTTP_PORT=8080
# 0.0.0.0 = mo tren LAN; 127.0.0.1 = chi local
BIND_ADDRESS=0.0.0.0
# 0 = khong cache static (tien khi dang sua plugin HTML/JS). Chay that: 604800
STATIC_CACHE=0

# --- Database (Postgres trong docker) ---
DB_CONTAINER=squash-tm-postgres
DB_PORT=5441
DB_NAME=squashtm
DB_USER=squash
# !! DOI MAT KHAU NAY truoc khi dung that
DB_PASSWORD=squash

# --- Toolchain ---
# Squash TM 13 BAT BUOC Java 21 (startup.sh chan phien ban thap hon)
JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
